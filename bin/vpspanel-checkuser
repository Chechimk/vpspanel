#!/usr/bin/env python3
"""vpspanel Checkuser: account status for VPN client apps.

Same API as the ADMRufu2.0 Checkuser (observed behaviour):

  GET  /             -> number of online connections (plain text)
  POST /checkuser    JSON {"user": "name"} -> expiry date (plain text), in
                     DDMMYYYY or epoch seconds, UTC or server time
  GET  /checkuser?user=name   (same answer, for convenience)

It runs unprivileged and only reads a status file that the panel's guard
writes every minute (no access to accounts or passwords).

Usage: vpspanel-checkuser --port 5000 --data /run/vpspanel/checkuser.json
"""
import argparse
import json
import logging
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

log = logging.getLogger("checkuser")


class Handler(BaseHTTPRequestHandler):
    data_file = ""

    def log_message(self, fmt, *args):
        log.info("%s %s", self.address_string(), fmt % args)

    def status(self) -> dict:
        try:
            with open(self.data_file, encoding="utf-8") as fh:
                return json.load(fh)
        except (OSError, ValueError):
            return {"online": 0, "users": {}}

    def text(self, code: int, body: str) -> None:
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(data)

    def answer_user(self, name: str) -> None:
        users = self.status().get("users", {})
        if name in users:
            self.text(200, str(users[name]))
        else:
            self.text(404, "")

    def do_GET(self):  # noqa: N802
        url = urlparse(self.path)
        if url.path.rstrip("/") == "/checkuser":
            name = (parse_qs(url.query).get("user") or [""])[0]
            self.answer_user(name)
        else:
            self.text(200, str(self.status().get("online", 0)))

    def do_POST(self):  # noqa: N802
        if urlparse(self.path).path.rstrip("/") != "/checkuser":
            self.text(404, "")
            return
        try:
            length = min(int(self.headers.get("Content-Length", 0)), 4096)
            req = json.loads(self.rfile.read(length) or b"{}")
            name = str(req.get("user", ""))
        except (ValueError, AttributeError):
            self.text(400, "invalid JSON")
            return
        self.answer_user(name)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--port", type=int, required=True)
    ap.add_argument("--data", default="/run/vpspanel/checkuser.json")
    args = ap.parse_args()
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    Handler.data_file = args.data
    server = ThreadingHTTPServer(("0.0.0.0", args.port), Handler)
    log.info("listening on port %d", args.port)
    server.serve_forever()


if __name__ == "__main__":
    main()
