#!/bin/bash
# vpspanel - interactive administration menu.
# Every screen is drawn by menu_show (lib/ui.sh): 0 = Back, x = Exit panel.
set -uo pipefail

VPSP_HOME=${VPSP_HOME:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}
# shellcheck source=../lib/common.sh
. "$VPSP_HOME/lib/common.sh"
# shellcheck source=../lib/accounts.sh
. "$VPSP_HOME/lib/accounts.sh"
# shellcheck source=../lib/system.sh
. "$VPSP_HOME/lib/system.sh"
# shellcheck source=../lib/ui.sh
. "$VPSP_HOME/lib/ui.sh"
for m in "$VPSP_HOME"/modules/*.sh; do
    # shellcheck source=/dev/null
    [[ -r $m ]] && . "$m"
done
load_config
# VPSP_MENU_LIB=1 loads the functions without starting the panel (test suite).
if [[ ${VPSP_MENU_LIB:-0} != 1 ]]; then
    require_root
    [[ -t 0 ]] || die "menu is interactive; use the 'vpspanel' command in scripts."
fi

CLI="$VPSP_HOME/bin/vpspanel"

# ============================================================= dashboard ===
account_counts() {
    local active=0 expired=0 locked=0 online=0 total=0 u
    for u in $(db_users); do
        acct_os_exists "$u" || continue
        total=$((total + 1))
        case $(acct_status "$u") in
            ACTIVE) active=$((active + 1)) ;; EXPIRED) expired=$((expired + 1)) ;; LOCKED) locked=$((locked + 1)) ;;
        esac
        (( $(acct_sessions "$u") > 0 )) && online=$((online + 1))
    done
    echo "$active $expired $locked $total $online"
}

# two-column line: "label value      label value"
dash_row() {
    local half=$(( UI_W / 2 - 1 ))
    printf ' %s%-7s%s%-*s %s%-7s%s%s\n' "$C_CYN" "$1" "$C_RST" "$(( half - 8 ))" "$2" "$C_CYN" "${3:-}" "$C_RST" "${4:-}"
}

dashboard() {
    local c used total free cache
    read -r -a c < <(account_counts)
    total=$(meminfo_mb MemTotal); free=$(meminfo_mb MemAvailable)
    cache=$(( $(meminfo_mb Cached) + $(meminfo_mb Buffers) ))
    used=$(( total - free ))
    ui_line
    ui_center "VPS PANEL  v$VPSP_VERSION" "$C_BLD$C_GRN"
    ui_line
    dash_row "OS:" "$(sys_os | cut -c1-$(( UI_W / 2 - 10 )))" "Host:" "$(sys_hostname | cut -c1-18)"
    dash_row "IP:" "$(sys_ip)" "Date:" "$(date '+%F %H:%M')"
    dash_row "RAM:" "${total} MB" "Used:" "${used} MB ($(( total ? used * 100 / total : 0 ))%)"
    dash_row "Free:" "${free} MB" "Cache:" "${cache} MB"
    dash_row "Swap:" "$(sys_swap)" "Disk:" "$(sys_disk)"
    dash_row "CPU:" "$(sys_cores) core(s) $(sys_cpu_pct)%" "Load:" "$(sys_load)"
    ui_line
    printf ' %sACTIVE%s %-4s %sEXPIRED%s %-4s %sLOCKED%s %-4s %sTOTAL%s %-4s %sONLINE%s %s\n' \
        "$C_GRN" "$C_RST" "${c[0]}" "$C_RED" "$C_RST" "${c[1]}" "$C_YLW" "$C_RST" "${c[2]}" \
        "$C_BLD" "$C_RST" "${c[3]}" "$C_CYN" "$C_RST" "${c[4]}"
}

# ========================================== 1. accounts (SSH/Dropbear) ===
# Prompt for an existing panel account, offering the list first.
pick_account() {
    local __var=$1 users name
    users=$(db_users)
    [[ -n $users ]] || { warn "There are no accounts yet."; return 1; }
    printf '  Accounts: %s\n' "$(echo $users)"
    ask name "Username" || return 1
    [[ -n $name ]] || return 1
    acct_is_panel "$name" || { err "No account named '$name'."; return 1; }
    printf -v "$__var" '%s' "$name"
}

# Connection details to hand to the customer.
account_summary() {
    local user=$1 pass=$2
    ui_line
    ui_kv "Host/IP:" "$(sys_ip)"
    ui_kv "Username:" "$user"
    ui_kv "Password:" "$pass"
    ui_kv "Expires:" "$(fmt_date "$(db_field "$user" 2)")"
    ui_kv "Login limit:" "$(db_field "$user" 3)"
    ui_kv "SSH ports:" "$(ssh_ports)"
    dropbear_installed && ui_kv "Dropbear:" "$(dropbear_port)"
    [[ -n $(wsp_ports) ]] && ui_kv "WebSocket:" "$(wsp_ports | paste -sd, -)"
    [[ -s $STN_PORTS ]] && ui_kv "SSL/TLS:" "$(cut -d: -f1 "$STN_PORTS" | paste -sd, -)"
    [[ -s $SQUID_PORTS ]] && ui_kv "Squid:" "$(paste -sd, "$SQUID_PORTS")"
    ui_line
    warn "The panel does not store passwords. Save these details now."
}

a_create() {
    local user pass days limit
    ask user "Username" || return
    valid_username "$user" || { err "Use 3-32 lowercase letters, digits, '_' or '-', starting with a letter."; return; }
    acct_os_exists "$user" && { err "User '$user' already exists."; return; }
    ask pass "Password" || return
    ask days "Valid for (days)" "$DEFAULT_DAYS" || return
    ask limit "Max simultaneous logins (0 = unlimited)" "$DEFAULT_LIMIT" || return
    "$CLI" create "$user" "$pass" "$days" "$limit" || return
    account_summary "$user" "$pass"
}

a_trial() {
    local user pass hours
    user="trial$(tr -dc 'a-z0-9' < /dev/urandom | head -c 4)"
    pass="$(tr -dc 'a-z0-9' < /dev/urandom | head -c 6)"
    ask user "Username" "$user" || return
    ask pass "Password" "$pass" || return
    ask hours "Valid for (hours, 1-168)" "2" || return
    "$CLI" trial "$user" "$pass" "$hours" 1 || return
    account_summary "$user" "$pass"
}

a_delete()   { local u; pick_account u && confirm "Delete '$u' and close its sessions?" && "$CLI" delete "$u"; }
a_renew()    {
    local u days
    pick_account u || return
    printf '  Current expiry: %s\n' "$(fmt_date "$(db_field "$u" 2)")"
    ask days "Add days" "$DEFAULT_DAYS" && "$CLI" renew "$u" "$days"
}
a_password() { local u p; pick_account u && ask p "New password" && "$CLI" passwd "$u" "$p"; }
a_limit()    {
    local u n
    pick_account u || return
    printf '  Current limit: %s\n' "$(db_field "$u" 3)"
    ask n "New limit (0 = unlimited)" && "$CLI" limit "$u" "$n"
}
a_lock() {
    local u
    pick_account u || return
    if acct_is_locked "$u"; then
        confirm "'$u' is locked. Unlock it?" && "$CLI" unlock "$u"
    else
        confirm "Lock '$u' and close its sessions?" && "$CLI" lock "$u"
    fi
}
a_details() {
    local u
    "$CLI" list
    [[ -n $(db_users) ]] || return 0
    printf '\n'
    ask u "Username for full details (Enter to skip)" || return 0
    [[ -n $u ]] && { ui_line; "$CLI" info "$u"; }
}
a_monitor() {
    local key rc
    while true; do
        clear 2>/dev/null
        ui_title "ONLINE USERS  (refreshes every 3 s - press any key to return)"
        "$CLI" online
        read -r -s -n 1 -t 3 key; rc=$?
        # Only a timeout (status > 128) refreshes; a key press or the end of
        # input (closed SSH session) leaves the monitor.
        (( rc > 128 )) || break
    done
}
a_purge()      { confirm "Delete every expired account?" && "$CLI" purge-expired; }
a_delete_all() {
    local word
    [[ -n $(db_users) ]] || { info "There are no accounts."; return 0; }
    warn "This deletes ALL $(db_users | grep -c .) panel accounts and closes their sessions."
    ask word "Type DELETE to confirm" || return
    [[ $word == DELETE ]] && "$CLI" delete-all || info "Cancelled."
}

# --- account limiter
onoff() { [[ $1 == 1 ]] && echo "${C_GRN}ON${C_RST}" || echo "${C_RED}OFF${C_RST}"; }
limiter_info() {
    ui_kv "Guard timer:" "$(fmt_state "$(svc_state vpspanel-guard.timer)") (checks every minute)"
    ui_kv "Expired limiter:" "$(onoff "$LIMIT_EXPIRED")"
    ui_kv "Login limiter:" "$(onoff "$LIMIT_LOGINS")"
    ui_kv "Auto-delete:" "$( (( AUTO_DELETE_DAYS > 0 )) && echo "$AUTO_DELETE_DAYS day(s) after expiry" || echo never)"
}
l_toggle() { set_config "$1" "$( [[ ${!1} == 1 ]] && echo 0 || echo 1 )" && ok "${*:2} is now $(onoff "${!1}")."; }
l_autodel() {
    local v
    ask v "Delete accounts this many days after expiry (0 = never)" "$AUTO_DELETE_DAYS" || return
    valid_int "$v" 0 3650 && set_config AUTO_DELETE_DAYS "$v" && ok "Saved." || err "Enter 0-3650."
}
l_log() {
    local found
    found=$(grep -E "  ($*)" "$VPSP_LOG" 2>/dev/null | tail -n 40)
    if [[ -n $found ]]; then printf '%s\n' "$found"; else info "The log has no entries yet."; fi
}
l_clear() {
    confirm "Remove limiter entries from the panel log?" || return 0
    [[ -f $VPSP_LOG ]] && sed -i -E '/  (expired |limit [a-z0-9_-]+: |auto-delete )/d' "$VPSP_LOG"
    ok "Limiter log cleared."
}
limiter_menu() {
    while menu_show "ACCOUNT LIMITER" limiter_info \
        "Expired-account limiter (on/off)|l_toggle LIMIT_EXPIRED The expired-account limiter" \
        "Multi-login limiter (on/off)|l_toggle LIMIT_LOGINS The multi-login limiter" \
        "Auto-delete expired accounts|l_autodel" \
        "Expired-account log|l_log expired|auto-delete" \
        "Multi-login log|l_log limit [a-z0-9_-]+:" \
        "Clear limiter log|l_clear"
    do :; done
}

# --- backups
backup_info() {
    ui_kv "Folder:" "$VPSP_BACKUP_DIR"
    ui_kv "Backups:" "$(acct_backup_list | grep -c .)"
}
b_pick() {
    local __v=$1 f n=0 choice
    local -a files=()
    while IFS= read -r f; do files+=("$f"); done < <(acct_backup_list)
    (( ${#files[@]} )) || { info "There are no backups in $VPSP_BACKUP_DIR."; return 1; }
    for f in "${files[@]}"; do n=$((n + 1)); ui_item "$n" "${f##*/}"; done
    ask choice "Backup" 1 || return 1
    valid_int "$choice" 1 "$n" || { err "Invalid choice."; return 1; }
    printf -v "$__v" '%s' "${files[choice - 1]}"
}
b_list()    { local f; while IFS= read -r f; do printf '  %s  %s\n' "${f##*/}" "$(du -h "$f" | cut -f1)"; done < <(acct_backup_list); [[ -n $(acct_backup_list) ]] || info "There are no backups."; }
b_restore() {
    local f
    info "You can also restore any file by path with: vpspanel restore FILE"
    b_pick f && confirm "Restore accounts from ${f##*/}? Existing users are kept." && "$CLI" restore "$f"
}
b_delete()  { local f; b_pick f && confirm "Delete ${f##*/}?" && rm -f "$f" && ok "Deleted."; }
backup_menu() {
    while menu_show "USER BACKUPS" backup_info \
        "Create a backup|$CLI backup" \
        "Restore a backup|b_restore" \
        "Delete a backup|b_delete" \
        "List backups|b_list" \
        "Automatic daily backups|soon"
    do :; done
}

ssh_accounts_info() {
    local c; read -r -a c < <(account_counts)
    ui_kv "Accounts:" "${c[3]} total  ${C_GRN}${c[0]} active${C_RST}  ${C_RED}${c[1]} expired${C_RST}  ${C_YLW}${c[2]} locked${C_RST}"
    ui_kv "Online now:" "${c[4]}"
}

ssh_accounts_menu() {
    while menu_show "SSH / DROPBEAR ACCOUNTS" ssh_accounts_info \
        "New user|a_create" \
        "Create temporary user|a_trial" \
        "Remove user|a_delete" \
        "Renew user|a_renew" \
        "Change password|a_password" \
        "Change connection limit|a_limit" \
        "Lock / unlock user|a_lock" \
        "User details|a_details" \
        "Online users monitor|>a_monitor" \
        "Account limiter|>limiter_menu" \
        "Delete expired users|a_purge" \
        "Delete all users|a_delete_all" \
        "User backups|>backup_menu" \
        "Account mode (HWID / token)|soon" \
        "Traffic quotas per user|soon"
    do :; done
}

# ======================================================= 4. protocols ===
# pline NAME STATE PORTS - one aligned protocol row.
pline() {
    local st
    case $2 in
        active) st="${C_GRN}ON ${C_RST}" ;;
        "not installed"|"") st="${C_DIM}-- ${C_RST}" ;;
        *) st="${C_RED}OFF${C_RST}" ;;
    esac
    printf '%-24s %s %s' "$1" "$st" "${3:+${C_CYN}$3${C_RST}}"
}

protocols_menu() {
    local xports wsp stn hyp sqp wgp
    while true; do
        wsp=$(wsp_ports | paste -sd, -)
        stn=$( [[ -s $STN_PORTS ]] && cut -d: -f1 "$STN_PORTS" | paste -sd, - )
        xports=$( xray_installed && jq -r '[.inbounds[].port] | map(tostring) | join(",")' "$XRAY_CONF" 2>/dev/null )
        hyp=$( hy_installed && echo "$(hy_get PORT)/udp" )
        sqp=$( [[ -s $SQUID_PORTS ]] && paste -sd, "$SQUID_PORTS" )
        wgp=$( wg_installed && echo "$(wg_port)/udp" )
        menu_show "PROTOCOL CONFIGURATION" - \
            "$(pline "SSH (OpenSSH)" "$(svc_state "$(ssh_unit)")" "$(ssh_ports)")|>ssh_menu" \
            "$(pline "Dropbear" "$(svc_state vpspanel-dropbear)" "$(dropbear_installed && dropbear_port)")|>dropbear_menu" \
            "$(pline "WebSocket / HTTP proxy" "$( [[ -n $wsp ]] && echo active)" "$wsp")|>wsp_menu" \
            "$(pline "Stunnel (SSL/TLS)" "$(svc_state vpspanel-stunnel)" "$stn")|>stunnel_menu" \
            "SlowDNS (DNSTT)|soon" \
            "UDP Custom|soon" \
            "$(pline "Hysteria2 (UDP)" "$(svc_state vpspanel-hysteria)" "$hyp")|>hysteria_menu" \
            "BadVPN UDPGW|soon" \
            "$(pline "Squid proxy" "$( [[ -n $sqp ]] && svc_state squid)" "$sqp")|>squid_menu" \
            "OpenVPN|soon" \
            "$(pline "V2Ray / Xray" "$(svc_state vpspanel-xray)" "$xports")|>xray_menu" \
            "$(pline "WireGuard" "$( wg_installed && svc_state wg-quick@wg0)" "$wgp")|>wireguard_menu" \
            "Checkuser|soon" \
            || return 0
    done
}

# ====================================================== 5. extra tools ===
maint_info() {
    ui_kv "RAM:" "$(sys_ram)"
    ui_kv "Swap:" "$(sys_swap)"
    ui_kv "Disk:" "$(sys_disk)"
}
maintenance_menu() {
    while menu_show "SYSTEM MAINTENANCE" maint_info \
        "Clean RAM / cache|clean_ram" \
        "Clean disk (apt cache, old logs, old temp files)|clean_disk" \
        "Create swap file|swap_create" \
        "Remove swap file|swap_remove" \
        "Scheduled tasks|soon"
    do :; done
}

bbr_info() { ui_kv "BBR:" "$(bbr_enabled && echo "${C_GRN}enabled${C_RST}" || echo disabled)"; ui_kv "Kernel:" "$(sys_kernel)"; }
bbr_toggle() { if bbr_enabled; then bbr_disable && ok "BBR disabled."; else bbr_enable && ok "BBR enabled."; fi; }
bbr_menu() { while menu_show "BBR ACCELERATION" bbr_info "Enable / disable BBR|bbr_toggle"; do :; done; }

tz_menu_set() {
    local tz
    info "Examples: UTC, Europe/London, America/New_York, Africa/Addis_Ababa, Asia/Dubai"
    ask tz "Time zone" "$(tz_current)" && tz_set "$tz" && ok "Time zone set to $tz. Time now: $(date '+%F %H:%M')"
}
tz_info() { ui_kv "Time zone:" "$(tz_current)"; ui_kv "Local time:" "$(date '+%F %H:%M:%S')"; }
tz_menu() { while menu_show "TIME ZONE" tz_info "Set time zone|tz_menu_set" "Use UTC|tz_set UTC"; do :; done; }

extra_menu() {
    while menu_show "EXTRA TOOLS" - \
        "SSL certificate manager|>ssl_menu" \
        "SSH/Dropbear banner|>banner_menu" \
        "Root password & access|>root_menu" \
        "System maintenance (RAM/disk/swap)|>maintenance_menu" \
        "Block torrent, ports & keywords|>firewall_menu" \
        "BBR acceleration|>bbr_menu" \
        "Fail2ban|>fail2ban_menu" \
        "DDoS protection|soon" \
        "Time zone|>tz_menu" \
        "Speedtest|run_speedtest" \
        "Plugin scripts|soon"
    do :; done
}

# ===================================================== 6. API and bots ===
api_menu() {
    while menu_show "API AND BOTS" - \
        "REST API|soon" \
        "Telegram bot|soon" \
        "WhatsApp bot|soon"
    do :; done
}

# =================================================== 7. panel settings ===
sysinfo_system() {
    ui_kv "OS:" "$(sys_os)"
    ui_kv "Kernel:" "$(sys_kernel)"
    ui_kv "Hostname:" "$(sys_hostname)"
    ui_kv "IP address:" "$(sys_ip)"
    ui_kv "Interface:" "$(sys_iface)"
    ui_kv "Uptime:" "$(sys_uptime)"
    ui_kv "Time zone:" "$(tz_current)"
    ui_kv "Panel:" "VPSPanel $VPSP_VERSION in $VPSP_HOME"
}
sysinfo_counter() {
    local c; read -r -a c < <(account_counts)
    ui_kv "Active:" "${c[0]}"; ui_kv "Expired:" "${c[1]}"; ui_kv "Locked:" "${c[2]}"; ui_kv "Total:" "${c[3]}"
    ui_kv "Online accounts:" "${c[4]}"
    ui_kv "SSH sessions:" "$(ps -eo comm= | grep -cE '^(sshd|sshd-session)$')"
    ui_kv "Dropbear:" "$(ps -eo comm= | grep -cx dropbear)"
    ui_kv "TCP established:" "$(ss -tnH state established 2>/dev/null | grep -c .)"
}
sysinfo_ram() { free -m; printf '\n'; ui_kv "Available:" "$(meminfo_mb MemAvailable) MB"; }
sysinfo_swap() { swapon --show 2>/dev/null; ui_kv "Swap:" "$(sys_swap)"; }
sysinfo_diskcpu() {
    df -h -x tmpfs -x devtmpfs -x overlay 2>/dev/null || df -h
    printf '\n'
    ui_kv "CPU model:" "$(awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo)"
    ui_kv "Cores:" "$(sys_cores)"
    ui_kv "CPU usage:" "$(sys_cpu_pct)%"
    ui_kv "Load average:" "$(sys_load)"
}
sysinfo_menu() {
    while menu_show "SYSTEM INFORMATION" - \
        "System information|sysinfo_system" \
        "Connection and account counter|sysinfo_counter" \
        "RAM memory|sysinfo_ram" \
        "Swap memory|sysinfo_swap" \
        "Disk and CPU|sysinfo_diskcpu"
    do :; done
}

defaults_info() {
    ui_kv "Default days:" "$DEFAULT_DAYS"
    ui_kv "Default limit:" "$DEFAULT_LIMIT"
}
d_days()  { local v; ask v "Days" "$DEFAULT_DAYS" && { valid_int "$v" 1 3650 && set_config DEFAULT_DAYS "$v" && ok "Saved." || err "Enter 1-3650."; }; }
d_limit() { local v; ask v "Logins (0 = unlimited)" "$DEFAULT_LIMIT" && { valid_int "$v" 0 999 && set_config DEFAULT_LIMIT "$v" && ok "Saved." || err "Enter 0-999."; }; }
defaults_menu() {
    while menu_show "ACCOUNT DEFAULTS" defaults_info \
        "Default validity (days)|d_days" \
        "Default login limit|d_limit"
    do :; done
}

panel_log() { if [[ -s $VPSP_LOG ]]; then tail -n 40 "$VPSP_LOG"; else info "The log is empty."; fi; }
panel_update() { "$VPSP_HOME/update.sh"; }
panel_about() {
    ui_kv "Version:" "$VPSP_VERSION"
    ui_kv "Installed in:" "$VPSP_HOME"
    ui_kv "Settings:" "$VPSP_ETC"
    ui_kv "Log:" "$VPSP_LOG"
    ui_kv "Source:" "$(cat "$VPSP_ETC/source" 2>/dev/null || echo "https://github.com/Chechimk/vpspanel")"
    printf '\n  Commands: menu (this panel), vpspanel (scripting - run "vpspanel help").\n'
}

settings_info() { ui_kv "Auto-start:" "$(autostart_enabled && echo "${C_GRN}on${C_RST} (panel opens at root SSH login)" || echo off)"; }

settings_menu() {
    while menu_show "PANEL SETTINGS" settings_info \
        "Auto-start panel at login (on/off)|autostart_toggle" \
        "System information|>sysinfo_menu" \
        "Account defaults|>defaults_menu" \
        "Panel log|panel_log" \
        "Update panel|panel_update" \
        "Scheduled tasks|soon" \
        "About VPSPanel|panel_about"
    do :; done
}

# ========================================================== main menu ===
uninstall_panel() {
    if confirm "Uninstall VPSPanel?"; then
        "$VPSP_HOME/uninstall.sh" && exit 0
    fi
}
logout_vps() {
    confirm "Close this SSH session?" || return 0
    clear
    kill -HUP "$PPID" 2>/dev/null || err "Could not close the session."
    exit 0
}
reboot_vps() {
    confirm "Reboot the server now? Every connection will drop." || return 0
    info "Rebooting..."
    log_event "reboot from panel"
    systemctl reboot 2>/dev/null || reboot
}

# Submenus use the compact top bar and "Back".
sub() { MENU_TOPBAR=ui_topbar MENU_ZERO_LABEL=Back; "$@"; }

main_menu() {
    while true; do
        MENU_TOPBAR=dashboard
        MENU_ZERO_LABEL=Exit
        menu_show "MAIN MENU" - \
            "Manage accounts (SSH/Dropbear)|>sub ssh_accounts_menu" \
            "Manage accounts (V2Ray/Xray)|>sub xray_users_menu" \
            "Manage accounts (WireGuard)|>sub wireguard_clients_menu" \
            "Protocol configuration|>sub protocols_menu" \
            "Extra tools|>sub extra_menu" \
            "API and bots|>sub api_menu" \
            "Panel settings|>sub settings_menu" \
            "Uninstall panel|uninstall_panel" \
            "Log out of VPS|logout_vps" \
            "Reboot VPS|reboot_vps" \
            || { clear 2>/dev/null; exit 0; }
    done
}

[[ ${VPSP_MENU_LIB:-0} == 1 ]] || main_menu
