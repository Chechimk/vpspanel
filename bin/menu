api_menu() {
    while menu_show "API AND BOTS" - \
        "API INSTALLER|soon" \
        "TELEGRAM BOT INSTALLER|soon" \
        "WHATSAPP BOT INSTALLER|soon"
    do :; done
}

# =================================================== script settings ===
sysinfo_system() {
    ui_kv "OS:" "$(sys_os)"
    ui_kv "Kernel:" "$(sys_kernel)"
    ui_kv "Hostname:" "$(sys_hostname)"
    ui_kv "IP address:" "$(sys_ip)"
    ui_kv "Interface:" "$(sys_iface)"
    ui_kv "Uptime:" "$(sys_uptime)"
    ui_kv "Time zone:" "$(tz_current)"
    ui_kv "Load average:" "$(sys_load)"
    ui_kv "SSH sessions:" "$(ps -eo comm= | grep -cE '^(sshd|sshd-session)$')"
    ui_kv "Dropbear:" "$(ps -eo comm= | grep -cx dropbear)"
    ui_kv "TCP established:" "$(ss -tnH state established 2>/dev/null | grep -c .)"
    ui_kv "Panel:" "$PANEL_NAME $VPSP_VERSION in $VPSP_HOME"
}

d_days()  { local v; ask v "Days" "$DEFAULT_DAYS" && { valid_int "$v" 1 3650 && set_config DEFAULT_DAYS "$v" && ok "Saved." || err "Enter 1-3650."; }; }
d_limit() { local v; ask v "Connections (0 = unlimited)" "$DEFAULT_LIMIT" && { valid_int "$v" 0 999 && set_config DEFAULT_LIMIT "$v" && ok "Saved." || err "Enter 0-999."; }; }
d_name()  { local v; ask v "Name shown at the top of the main menu" "$PANEL_NAME" && { [[ $v =~ ^[[:print:]]{1,30}$ ]] && set_config PANEL_NAME "$v" && ok "Saved." || err "Use 1-30 printable characters."; }; }

panel_log() { show_log "$VPSP_LOG"; }
panel_update() { "$VPSP_HOME/update.sh"; }
panel_about() {
    ui_kv "Version:" "$VPSP_VERSION"
    ui_kv "Installed in:" "$VPSP_HOME"
    ui_kv "Settings:" "$VPSP_ETC"
    ui_kv "Log:" "$VPSP_LOG"
    ui_kv "Source:" "$(cat "$VPSP_ETC/source" 2>/dev/null || echo "https://github.com/Chechimk/vpspanel")"
    printf '\n  Commands: menu (this panel), vpspanel (scripting - run "vpspanel help").\n'
}
a_toggle_autostart() { autostart_toggle; }

settings_menu() {
    while menu_show "SCRIPT SETTINGS" - \
        "CONNECTION AND ACCOUNT COUNTER $(st_onoff "$DASH_COUNTERS")|!l_toggle DASH_COUNTERS The account counter" \
        "SYSTEM INFORMATION $(st_onoff "$DASH_SYSINFO")|!l_toggle DASH_SYSINFO System information" \
        "DISK AND CPU INFORMATION $(st_onoff "$DASH_DISKCPU")|!l_toggle DASH_DISKCPU Disk and CPU information" \
        "RAM INFORMATION $(st_onoff "$DASH_RAM")|!l_toggle DASH_RAM RAM information" \
        "SWAP INFORMATION $(st_onoff "$DASH_SWAP")|!l_toggle DASH_SWAP Swap information" \
        - \
        "AUTO-START PANEL AT LOGIN $(st_onoff "$(autostart_enabled && echo 1 || echo 0)")|!a_toggle_autostart" \
        - \
        "PANEL NAME: $PANEL_NAME|d_name" \
        "SYSTEM DETAILS|sysinfo_system" \
        "PANEL LOG|panel_log" \
        - \
        "UPDATE PANEL|panel_update" \
        "ABOUT VPSPANEL|panel_about"
    do :; done
}

# ========================================================== main menu ===
uninstall_panel() {
    if confirm "Uninstall VPSPanel?"; then
        "$VPSP_HOME/uninstall.sh" && exit 0
    fi
}
# As in ADMRufu, 0 on the main menu leaves the VPS (closes this SSH session).
logout_vps() {
    clear 2>/dev/null
    kill -HUP "$PPID" 2>/dev/null
    exit 0
}
exit_panel() { clear 2>/dev/null; exit 0; }
reboot_vps() {
    confirm "Reboot the server now? Every connection will drop." || return 0
    info "Rebooting..."
    log_event "reboot from panel"
    systemctl reboot 2>/dev/null || reboot
}

# Submenus: no dashboard, "Back" on 0.
sub() { MENU_TOPBAR="" MENU_ZERO_LABEL=Back; "$@"; }

main_menu() {
    local -a items
    while true; do
        load_config
        items=("MANAGE ACCOUNTS (SSH/DROPBEAR)|>sub ssh_accounts_menu")
        xray_installed && items+=("MANAGE ACCOUNTS (V2RAY/XRAY)|>sub xray_users_menu")
        wg_installed && items+=("MANAGE ACCOUNTS (WIREGUARD)|>sub wireguard_clients_menu")
        items+=(- "PROTOCOL CONFIGURATION|>sub protocols_menu" "EXTRA TOOLS|>sub extra_menu" -
                "API AND BOTS|>sub api_menu" -
                "SCRIPT SETTINGS|>sub settings_menu" -
                "${C_YLW}[!]${C_RED} UNINSTALL PANEL|uninstall_panel"
                "@${C_BG_GRY}EXIT PANEL|exit_panel"
                "@${C_BG_BLU}REBOOT VPS|reboot_vps")
        MENU_TOPBAR=dashboard
        MENU_ZERO_LABEL="${C_BG_RED}LOG OUT OF VPS"
        menu_show "" - "${items[@]}" || logout_vps
    done
}

[[ ${VPSP_MENU_LIB:-0} == 1 ]] || main_menu
