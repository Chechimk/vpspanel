#!/bin/bash
# vpspanel - interactive administration menu.
# Every screen is drawn by menu_show (lib/ui.sh): 0 = Back, x = Exit panel.
# The layout follows the ADMRufu2.0 panel as observed in
# docs/ADMRUFU-FULL-STRUCTURE.md; all code here is original.
set -uo pipefail

VPSP_HOME=${VPSP_HOME:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}
# shellcheck source=../lib/common.sh
. "$VPSP_HOME/lib/common.sh"
# shellcheck source=../lib/accounts.sh
. "$VPSP_HOME/lib/accounts.sh"
# shellcheck source=../lib/system.sh
. "$VPSP_HOME/lib/system.sh"
# shellcheck source=../lib/ui.sh
. "$VPSP_HOME/lib/ui.sh"
for m in "$VPSP_HOME"/modules/*.sh; do
    # shellcheck source=/dev/null
    [[ -r $m ]] && . "$m"
done
load_config
# VPSP_MENU_LIB=1 loads the functions without starting the panel (test suite).
if [[ ${VPSP_MENU_LIB:-0} != 1 ]]; then
    require_root
    [[ -t 0 ]] || die "menu is interactive; use the 'vpspanel' command in scripts."
fi

CLI="$VPSP_HOME/bin/vpspanel"

# ============================================================= dashboard ===
account_counts() {
    local active=0 expired=0 locked=0 online=0 total=0 u
    for u in $(db_users); do
        acct_os_exists "$u" || continue
        total=$((total + 1))
        case $(acct_status "$u") in
            ACTIVE) active=$((active + 1)) ;; EXPIRED) expired=$((expired + 1)) ;; LOCKED) locked=$((locked + 1)) ;;
        esac
        (( $(acct_sessions "$u") > 0 )) && online=$((online + 1))
    done
    echo "$active $expired $locked $total $online"
}

# Box lines of the dashboard: ╔═══╗, ╠══ LABEL ══╣, ╚═══╝ (ASCII without UTF-8).
_box() {
    local l=$1 r=$2 label=${3:-} h='═' inner left right
    [[ $UI_RULE == =* ]] && { h='='; l='+'; r='+'; }
    inner=$(( UI_W - 2 ))
    if [[ -n $label ]]; then
        left=$(( (inner - ${#label}) / 2 )); right=$(( inner - left - ${#label} ))
        printf '%s%s%s%s%s%s%s%s\n' "$C_FRM" "$l" "$(printf '%*s' "$left" '' | sed "s/ /$h/g")" \
            "$C_YLW" "$label" "$C_FRM" "$(printf '%*s' "$right" '' | sed "s/ /$h/g")$r" "$C_RST"
    else
        printf '%s%s%s%s%s\n' "$C_FRM" "$l" "$(printf '%*s' "$inner" '' | sed "s/ /$h/g")" "$r" "$C_RST"
    fi
}
# dash_row L1 V1 L2 V2 [L3 V3] - label/value columns inside the box.
dash_row() {
    local out=''
    while (( $# >= 2 )); do
        out+=$(printf '%s%-8s%s%-11s%s' "$C_GRN" "$1" "$C_WHT" "$2" "$C_RST")
        shift 2
    done
    printf '  %s\n' "$out"
}
dash_row2() { printf '  %s%-8s%s%-31s%s%-8s%s%s%s\n' "$C_GRN" "$1" "$C_WHT" "$2" "$C_GRN" "$3" "$C_WHT" "$4" "$C_RST"; }
human_kb() { awk -v k="$1" 'BEGIN { if (k >= 1048576) printf "%.2fGB", k/1048576; else printf "%.2fMB", k/1024 }'; }
mem_kb() { awk -v k="$1:" '$1 == k { print $2 }' /proc/meminfo 2>/dev/null; }

dashboard() {
    local c t u f
    ui_line
    ui_center "$PANEL_NAME v$VPSP_VERSION" "$C_YLW"
    if [[ $DASH_SYSINFO == 1 ]]; then
        _box '╔' '╗'
        dash_row2 "OS:" "$(sys_os | cut -c1-30)" "Date:" "$(date '+%d-%m-%Y')"
        dash_row2 "IP:" "$(sys_ip)" "Time:" "$(date '+%H:%M:%S')"
    else
        _box '╔' '╗'
    fi
    if [[ $DASH_DISKCPU == 1 ]]; then
        read -r t u f < <(df -Pk / 2>/dev/null | awk 'NR==2 {print $2, $3, $4}')
        _box '╠' '╣' "Disk / CPU"
        dash_row "Total:" "$(human_kb "${t:-0}")" "Avail:" "$(human_kb "${f:-0}")" "Cores:" "$(sys_cores)"
        dash_row "Used:" "$(human_kb "${u:-0}")" "Use%:" "$(( t ? u * 100 / t : 0 ))%" "CPU:" "$(sys_cpu_pct)%"
    fi
    if [[ $DASH_RAM == 1 ]]; then
        t=$(mem_kb MemTotal); f=$(mem_kb MemAvailable)
        _box '╠' '╣' "RAM"
        dash_row "Total:" "$(human_kb "${t:-0}")" "Used:" "$(human_kb $(( ${t:-0} - ${f:-0} )))" "Free:" "$(human_kb "$(mem_kb MemFree)")"
        dash_row "Buffer:" "$(human_kb "$(mem_kb Buffers)")" "Cache:" "$(human_kb "$(mem_kb Cached)")" "Avail:" "$(human_kb "${f:-0}")"
    fi
    if [[ $DASH_SWAP == 1 ]]; then
        t=$(mem_kb SwapTotal); f=$(mem_kb SwapFree)
        _box '╠' '╣' "Swap"
        dash_row "Total:" "$(human_kb "${t:-0}")" "Free:" "$(human_kb "${f:-0}")" "Used:" "$(human_kb $(( ${t:-0} - ${f:-0} )))"
    fi
    _box '╚' '╝'
    if [[ $DASH_COUNTERS == 1 ]]; then
        read -r -a c < <(account_counts)
        printf '  %sACTIVE: %s%s  %sEXPIRED: %s%s  %sLOCKED: %s%s  %sTOTAL: %s%s  %sONLINE: %s%s\n' \
            "$C_GRN" "${c[0]}" "$C_RST" "$C_RED" "${c[1]}" "$C_RST" "$C_CYN" "${c[2]}" "$C_RST" \
            "$C_YLW" "${c[3]}" "$C_RST" "$C_BLU" "${c[4]}" "$C_RST"
    fi
    ui_line
}

# ========================================== 1. accounts (SSH/Dropbear) ===
# User table as on ADMRufu screens: number, name, expiry, days left, limit, status.
user_table() {
    local u n=0 exp lim st days
    local -a users
    mapfile -t users < <(db_users)
    if (( ${#users[@]} == 0 )); then ui_center "THERE ARE NO USERS YET" "$C_YLW"; return 1; fi
    printf ' %s%-5s %-20s %-17s %4s %4s %s%s\n' "$C_YLW" "No." "User" "Expires" "Days" "Lim" "Sta" "$C_RST"
    ui_sep
    for u in "${users[@]}"; do
        n=$((n + 1))
        if ! acct_os_exists "$u"; then printf ' %4s) %-20s %s\n' "$n" "$u" "${C_RED}missing (repair)${C_RST}"; continue; fi
        exp=$(db_field "$u" 2); lim=$(db_field "$u" 3); days=$(days_left "$exp")
        [[ $lim == 0 ]] && lim='-'
        [[ $(db_field "$u" 5) == trial ]] && days="${days}T"
        case $(acct_status "$u") in
            ACTIVE)  st="${C_GRN}ACT${C_RST}" ;;
            EXPIRED) st="${C_RED}EXP${C_RST}" ;;
            LOCKED)  st="${C_CYN}LOK${C_RST}" ;;
        esac
        printf ' %4s) %s%-20s%s %-17s %4s %4s %s\n' "$n" "$C_WHT" "$u" "$C_RST" "$(fmt_date "$exp")" "$days" "$lim" "$st"
    done
}

# pick_account VAR SHOWFLAG - choose an account by number or name.
pick_account() {
    local __var=$1 show=${2:-1} name
    local -a users
    mapfile -t users < <(db_users)
    (( ${#users[@]} )) || { warn "There are no accounts yet."; return 1; }
    if [[ $show == 1 ]]; then user_table; ui_line; fi
    if [[ $SELECT_BY_NAME == 1 ]]; then ask name "Name" || return 1
    else ask name "Number or name (Enter = back)" || return 1; fi
    [[ -n $name ]] || return 1
    if [[ $name =~ ^[0-9]+$ ]] && (( name >= 1 && name <= ${#users[@]} )); then name=${users[name - 1]}; fi
    acct_is_panel "$name" || { err "No account '$name'."; return 1; }
    printf -v "$__var" '%s' "$name"
}

# ask_until VAR "Prompt" TEST [default] - re-ask until TEST VALUE succeeds.
ask_until() {
    local __v=$1 __p=$2 __t=$3 __d=${4:-} __a
    while true; do
        ask __a "$__p" "$__d" || return 1
        if $__t "$__a"; then printf -v "$__v" '%s' "$__a"; return 0; fi
    done
}
_ok_newname() {
    valid_username "$1" || { err "Use 2-32 lowercase letters, digits, '_' or '-', starting with a letter."; return 1; }
    ! acct_os_exists "$1" || { err "User '$1' already exists."; return 1; }
}
_ok_pass()  { valid_password "$1" || { err "Use 3-64 characters with no spaces or ':'."; return 1; }; }
_ok_days()  { valid_int "$1" 1 3650 || { err "Enter a number of days (1-3650)."; return 1; }; }
_ok_mins()  { valid_int "$1" 1 10080 || { err "Enter minutes (1-10080)."; return 1; }; }
_ok_limit() { valid_int "$1" 0 999 || { err "Enter 0-999 (0 = unlimited)."; return 1; }; }

# save_prompt - "[0] Back  [1] Retry  Enter Save". Returns 0 save, 1 back, 2 retry.
save_prompt() {
    local a
    ui_line
    printf '  %s[0]%s Back            %s[1]%s Retry           %sEnter%s Save\n' "$C_GRN" "$C_RST" "$C_GRN" "$C_RST" "$C_GRN" "$C_RST"
    ui_line
    read -r -p " ${C_WHT}Enter an option:${C_RST} " a || return 1
    case $a in 0) return 1 ;; 1) return 2 ;; *) return 0 ;; esac
}

# Connection details to hand to the customer.
account_summary() {
    local user=$1 pass=$2 exp
    exp=$(db_field "$user" 2)
    ui_title "USER CREATED SUCCESSFULLY!"
    ui_kv "Server IP:" "$(sys_ip)"
    ui_kv "Username:" "$user"
    ui_kv "Password:" "$pass"
    if [[ $(db_field "$user" 5) == trial ]]; then ui_kv "Deleted at:" "$(fmt_date "$exp")"
    else ui_kv "Expires in:" "$(days_left "$exp") DAYS ($(fmt_date "$exp"))"; fi
    ui_kv "Connections:" "$( [[ $(db_field "$user" 3) == 0 ]] && echo unlimited || db_field "$user" 3)"
    ui_thin
    ui_kv "SSH ports:" "$(ssh_ports)"
    dropbear_installed && ui_kv "Dropbear:" "$(dropbear_ports | paste -sd' ' -)"
    [[ -n $(wsp_ports) ]] && ui_kv "WS/HTTP proxy:" "$(wsp_ports | paste -sd' ' -)"
    [[ -s $STN_PORTS ]] && ui_kv "SSL/TLS:" "$(cut -d: -f1 "$STN_PORTS" | paste -sd' ' -)"
    [[ -s $SQUID_PORTS ]] && ui_kv "Squid:" "$(paste -sd' ' "$SQUID_PORTS")"
    declare -F bv_ports > /dev/null && [[ -n $(bv_ports) ]] && ui_kv "BadVPN UDPGW:" "$(bv_ports | paste -sd' ' -)"
    declare -F sdns_installed > /dev/null && sdns_installed && ui_kv "SlowDNS NS:" "$(sdns_get NS)"
    if hy_installed && [[ $(hy_get AUTH) == accounts ]]; then
        ui_kv "Hysteria2:" "UDP $(hy_get PORT) (login with this account)"
        printf '  %s\n' "$(hy_link "$user" "$pass")"
    fi
    declare -F ovpn_installed > /dev/null && ovpn_installed && ui_kv "OpenVPN:" "$(ovpn_get PROTO | tr a-z A-Z) $(ovpn_get PORT) (login with this account)"
    ui_line
    warn "VPSPanel does not store passwords in plain text. Save these details now."
}

a_create() {
    local user pass days limit rc
    while true; do
        clear 2>/dev/null; ui_title "ADD NEW USER"
        [[ $SHOW_LIST_NEW == 1 ]] && { user_table; ui_line; }
        ask_until user "NAME" _ok_newname || return
        if [[ $GEN_PASS_ON == 1 && -n $GEN_PASS ]]; then pass=$GEN_PASS; ui_kv "PASSWORD:" "general password"
        else ask_until pass "PASSWORD" _ok_pass || return; fi
        ask_until days "EXPIRES IN (days)" _ok_days "$DEFAULT_DAYS" || return
        ask_until limit "CONNECTIONS (0 = unlimited)" _ok_limit "$DEFAULT_LIMIT" || return
        save_prompt; rc=$?
        (( rc == 1 )) && return 0
        (( rc == 2 )) && continue
        "$CLI" create "$user" "$pass" "$days" "$limit" > /dev/null || return
        clear 2>/dev/null; account_summary "$user" "$pass"
        return 0
    done
}

a_trial() {
    local user pass mins limit rc
    while true; do
        clear 2>/dev/null; ui_title "CREATE TEMPORARY USER"
        [[ $SHOW_LIST_NEW == 1 ]] && { user_table; ui_line; }
        ask_until user "NAME" _ok_newname || return
        if [[ $GEN_PASS_ON == 1 && -n $GEN_PASS ]]; then pass=$GEN_PASS; ui_kv "PASSWORD:" "general password"
        else ask_until pass "PASSWORD" _ok_pass || return; fi
        ask_until mins "MINUTES" _ok_mins 60 || return
        ask_until limit "CONNECTIONS (0 = unlimited)" _ok_limit 1 || return
        save_prompt; rc=$?
        (( rc == 1 )) && return 0
        (( rc == 2 )) && continue
        "$CLI" trial "$user" "$pass" "$mins" "$limit" > /dev/null || return
        clear 2>/dev/null; account_summary "$user" "$pass"
        info "The user is deleted automatically after $mins minute(s)."
        return 0
    done
}

a_delete() {
    local u
    clear 2>/dev/null; ui_title "REMOVE USERS"
    pick_account u "$SHOW_LIST_DEL" || return 0
    confirm "Delete '$u' and close its sessions?" && "$CLI" delete "$u"
}
a_renew() {
    local u days
    clear 2>/dev/null; ui_title "RENEW USERS"
    pick_account u "$SHOW_LIST_RENEW" || return 0
    ui_sep
    ui_kv "Current expiry:" "$(fmt_date "$(db_field "$u" 2)")"
    ask_until days "EXPIRES IN (days from today)" _ok_days "$DEFAULT_DAYS" || return
    "$CLI" renew "$u" "$days"
}
a_edit() {
    local u pass limit
    clear 2>/dev/null; ui_title "EDIT USERS"
    pick_account u "$SHOW_LIST_EDIT" || return 0
    ui_sep
    ask pass "NEW PASSWORD (Enter = keep)" || return
    [[ -z $pass ]] || _ok_pass "$pass" || return
    ask_until limit "CONNECTIONS (0 = unlimited)" _ok_limit "$(db_field "$u" 3)" || return
    if [[ -n $pass ]]; then "$CLI" edit "$u" "$pass" "$limit"; else "$CLI" limit "$u" "$limit"; fi \
        && ui_center "USER MODIFIED SUCCESSFULLY!" "$C_GRN"
}
a_lock() {
    local u
    clear 2>/dev/null; ui_title "LOCK/UNLOCK USERS"
    pick_account u "$SHOW_LIST_LOCK" || return 0
    if acct_is_locked "$u"; then "$CLI" unlock "$u" && ui_center "USER UNLOCKED SUCCESSFULLY!" "$C_GRN"
    else run_step "closing sessions" acct_kill_sessions "$u"; "$CLI" lock "$u" && ui_center "USER LOCKED SUCCESSFULLY!" "$C_GRN"; fi
}
a_details() {
    local u
    user_table || return 0
    ui_line
    ask u "Number or name for full details (Enter = skip)" || return 0
    [[ -n $u ]] || return 0
    if [[ $u =~ ^[0-9]+$ ]]; then u=$(db_users | sed -n "${u}p"); fi
    [[ -n $u ]] && { ui_sep; "$CLI" info "$u"; }
}
a_monitor() {
    local key rc u n lim i
    while true; do
        clear 2>/dev/null
        ui_line
        printf '  %s%-28s %8s %8s%s\n' "$C_WHT" "NAME" "ONLINE" "LIMIT" "$C_RST"
        ui_line
        i=0
        for u in $(db_users); do
            acct_os_exists "$u" || continue
            i=$((i + 1)); n=$(acct_sessions "$u"); lim=$(db_field "$u" 3); [[ $lim == 0 ]] && lim='-'
            printf ' %3s)-%-26s %s%8s%s %8s\n' "$i" "$u" "$( (( n > 0 )) && echo "$C_GRN" )" "$n" "$C_RST" "$lim"
        done
        (( i )) || ui_center "THERE ARE NO USERS YET"
        ui_line
        ui_center "Refreshes every 3 s - press Enter to return" "$C_YLW"
        read -r -t 3 key; rc=$?
        # Only a timeout (status > 128) refreshes; Enter or the end of input
        # (closed SSH session) leaves the monitor.
        (( rc > 128 )) || break
    done
}
a_purge()      { confirm "Delete every expired account?" && "$CLI" purge-expired; }
a_delete_all() {
    local word
    [[ -n $(db_users) ]] || { info "There are no accounts."; return 0; }
    warn "This deletes ALL $(db_users | grep -c .) panel accounts and closes their sessions."
    ask word "Type DELETE to confirm" || return
    [[ $word == DELETE ]] && "$CLI" delete-all || info "Cancelled."
}

# --- general password
genpass_info() { :; }
g_toggle() {
    if [[ $GEN_PASS_ON != 1 && -z $GEN_PASS ]]; then err "Set a password first (option 2)."; return 1; fi
    set_config GEN_PASS_ON "$( [[ $GEN_PASS_ON == 1 ]] && echo 0 || echo 1 )" && ok "General password is now $(st_onoff "$GEN_PASS_ON")."
}
g_set() {
    local p
    ask_until p "PASSWORD" _ok_pass || return
    set_config GEN_PASS "$p" && ok "General password saved."
}
genpass_menu() {
    while menu_show "GENERAL PASSWORD" - \
        "STATUS $(st_onoff "$GEN_PASS_ON")|!g_toggle" \
        "PASSWORD: ${GEN_PASS:-not set}|g_set"
    do :; done
}

# --- account limiter
limiter_info() {
    ui_kv "Guard timer:" "$(fmt_state "$(svc_state vpspanel-guard.timer)") (checks every minute)"
    ui_kv "Auto-delete:" "$( (( AUTO_DELETE_DAYS > 0 )) && echo "$AUTO_DELETE_DAYS day(s) after expiry" || echo never)"
}
l_toggle() { set_config "$1" "$( [[ ${!1} == 1 ]] && echo 0 || echo 1 )" && ok "${*:2} is now $(st_onoff "${!1}")."; }
l_autodel() {
    local v
    ask v "Delete accounts this many days after expiry (0 = never)" "$AUTO_DELETE_DAYS" || return
    valid_int "$v" 0 3650 && set_config AUTO_DELETE_DAYS "$v" && ok "Saved." || err "Enter 0-3650."
}
l_log() {
    local found
    found=$(grep -E "  ($*)" "$VPSP_LOG" 2>/dev/null | tail -n 40)
    if [[ -n $found ]]; then printf '%s\n' "$found"; else info "The log has no entries yet."; fi
}
l_clear() {
    confirm "Remove limiter entries from the panel log?" || return 0
    [[ -f $VPSP_LOG ]] && sed -i -E '/  (expired |limit [a-z0-9_-]+: |auto-delete )/d' "$VPSP_LOG"
    ok "Limiter log cleared."
}
l_notes() {
    info "The guard timer runs every minute (systemd: vpspanel-guard.timer)."
    info "Expired-account limiter: closes sessions of expired accounts and blocks new logins."
    info "Multi-login limiter: closes the newest sessions above each account's limit."
    info "Temporary users are deleted when their minutes run out, whatever these settings."
}
limiter_menu() {
    while menu_show "ACCOUNT LIMITER" limiter_info \
        "EXPIRED-ACCOUNT LIMITER $(st_onoff "$LIMIT_EXPIRED")|!l_toggle LIMIT_EXPIRED The expired-account limiter" \
        "VIEW EXPIRED-ACCOUNT LOG|l_log expired|auto-delete" \
        - \
        "MULTI-LOGIN LIMITER $(st_onoff "$LIMIT_LOGINS")|!l_toggle LIMIT_LOGINS The multi-login limiter" \
        "VIEW MULTI-LOGIN LOG|l_log limit [a-z0-9_-]+:" \
        - \
        "AUTO-DELETE EXPIRED ACCOUNTS|l_autodel" \
        "CLEAR LIMITER LOG|l_clear" \
        "@Notes|l_notes"
    do :; done
}

# --- backups
backup_info() {
    ui_kv "Folder:" "$VPSP_BACKUP_DIR"
    ui_kv "Backups:" "$(acct_backup_list | grep -c .)"
}
b_pick() {
    local __v=$1 __f __n=0 __c
    local -a files=()
    while IFS= read -r __f; do files+=("$__f"); done < <(acct_backup_list)
    (( ${#files[@]} )) || { info "There are no backups in $VPSP_BACKUP_DIR."; return 1; }
    for __f in "${files[@]}"; do __n=$((__n + 1)); ui_item "$__n" "${__f##*/}"; done
    ui_line
    ask __c "Backup" 1 || return 1
    valid_int "$__c" 1 "$__n" || { err "Invalid choice."; return 1; }
    printf -v "$__v" '%s' "${files[__c - 1]}"
}
b_list()    { local f; while IFS= read -r f; do printf '  %s  %s\n' "${f##*/}" "$(du -h "$f" | cut -f1)"; done < <(acct_backup_list); [[ -n $(acct_backup_list) ]] || info "There are no backups."; }
b_restore() {
    local f
    info "You can also restore any file by path with: vpspanel restore FILE"
    b_pick f && confirm "Restore accounts from ${f##*/}? Existing users are kept." && "$CLI" restore "$f"
}
b_delete()  { local f; b_pick f && confirm "Delete ${f##*/}?" && rm -f "$f" && ok "Deleted."; }
b_import() {
    local f
    info "ADMRufu2.0 keeps user backups in /root/ADMRufu/userSSH/backups_users_*.admrufu"
    for f in /root/ADMRufu/userSSH/*.admrufu; do [[ -f $f ]] && printf '  %s\n' "$f"; done
    ask f "Path of the .admrufu file" || return
    [[ -n $f ]] && "$CLI" import-admrufu "$f"
}
backup_menu() {
    while menu_show "USER BACKUPS" backup_info \
        "AUTO-BACKUPS (daily) $(st_onoff "$AUTO_BACKUP")|!l_toggle AUTO_BACKUP Automatic daily backup" \
        - \
        "CREATE A NEW USER BACKUP|$CLI backup" \
        "RESTORE A USER BACKUP|b_restore" \
        - \
        "DELETE A USER BACKUP|b_delete" \
        "LIST BACKUPS|b_list" \
        - \
        "IMPORT AN ADMRUFU2.0 BACKUP|b_import"
    do :; done
}

# --- account manager settings
acctcfg_menu() {
    while menu_show "ACCOUNT MANAGER SETTINGS" - \
        "SHOW USER LIST IN NEW USER $(st_onoff "$SHOW_LIST_NEW")|!l_toggle SHOW_LIST_NEW The list in New user" \
        "SHOW USER LIST IN REMOVE $(st_onoff "$SHOW_LIST_DEL")|!l_toggle SHOW_LIST_DEL The list in Remove" \
        "SHOW USER LIST IN RENEW $(st_onoff "$SHOW_LIST_RENEW")|!l_toggle SHOW_LIST_RENEW The list in Renew" \
        "SHOW USER LIST IN EDIT $(st_onoff "$SHOW_LIST_EDIT")|!l_toggle SHOW_LIST_EDIT The list in Edit" \
        "SHOW USER LIST IN LOCK/UNLOCK $(st_onoff "$SHOW_LIST_LOCK")|!l_toggle SHOW_LIST_LOCK The list in Lock/unlock" \
        - \
        "SELECT USERS BY NAME $(st_onoff "$SELECT_BY_NAME")|!l_toggle SELECT_BY_NAME Selection by name" \
        - \
        "SHOW TEMPORARY-USER OPTION $(st_onoff "$SHOW_TEMP")|!l_toggle SHOW_TEMP The temporary-user option" \
        - \
        "DATES IN SERVER TIME ZONE (OFF = UTC) $(st_onoff "$LOCAL_TIME")|!l_toggle LOCAL_TIME Server-time dates" \
        - \
        "DEFAULT DAYS: $DEFAULT_DAYS|d_days" \
        "DEFAULT CONNECTIONS: $DEFAULT_LIMIT|d_limit"
    do :; done
}

ssh_accounts_menu() {
    local -a items
    while true; do
        items=("NEW USER|a_create")
        [[ $SHOW_TEMP == 1 ]] && items+=("CREATE TEMPORARY USER|a_trial")
        items+=("REMOVE USER|a_delete" "RENEW USER|a_renew" "EDIT USER|a_edit" "LOCK/UNLOCK USER|a_lock" -
                "GENERAL PASSWORD|>genpass_menu" -
                "DETAILS OF ALL USERS|a_details" "ONLINE USERS MONITOR|>a_monitor" "ACCOUNT LIMITER|>limiter_menu" -
                "DELETE EXPIRED USERS|a_purge" "DELETE ALL USERS|a_delete_all" -
                "USER BACKUPS|>backup_menu" -
                "ACCOUNT MANAGER SETTINGS|>acctcfg_menu"
                "@SWITCH TO HWID/TOKEN MODE|soon")
        menu_show "SSH USER ADMINISTRATION" - "${items[@]}" || return 0
    done
}

# ======================================================== protocols ===
# Port summary shown above the protocol list.
proto_ports_info() {
    local -a cells=() ; local c i line
    cells+=("SSH: $(ssh_ports | tr '\n' ' ')")
    dropbear_installed && cells+=("DROPBEAR: $(dropbear_ports | paste -sd' ' -)")
    [[ -n $(wsp_ports) ]] && cells+=("WS/HTTP: $(wsp_ports | paste -sd' ' -)")
    [[ -s $STN_PORTS ]] && cells+=("STUNNEL: $(cut -d: -f1 "$STN_PORTS" | paste -sd' ' -)")
    sdns_installed && cells+=("SLOWDNS: 5300")
    hy_installed && cells+=("HYSTERIA2: $(hy_get PORT)")
    [[ -n $(bv_ports) ]] && cells+=("BADVPN: $(bv_ports | paste -sd' ' -)")
    [[ -s $SQUID_PORTS ]] && cells+=("SQUID: $(paste -sd' ' "$SQUID_PORTS")")
    ovpn_installed && cells+=("OPENVPN-$(ovpn_get PROTO | tr a-z A-Z): $(ovpn_get PORT)")
    cu_installed && cells+=("CHECKUSER: $(cu_get PORT)")
    xray_installed && cells+=("XRAY: $(jq -r '[.inbounds[] | select(.tag != "api") | .port | tostring] | join(" ")' "$XRAY_CONF" 2>/dev/null)")
    wg_installed && cells+=("WIREGUARD: $(wg_port)")
    for (( i = 0; i < ${#cells[@]}; i += 2 )); do
        c=${cells[i]:0:29}
        line=$(printf ' %s%-30s' "$C_YLW" "$c")
        (( i + 1 < ${#cells[@]} )) && line+="${cells[i + 1]:0:29}"
        printf '%s%s\n' "$line" "$C_RST"
    done
}
pst() { printf '%-17s %s' "$1" "$(st_state "$2")"; }

protocols_menu() {
    local ret
    while true; do
        MENU_COLS=2
        menu_show "PROTOCOL ADMINISTRATION" proto_ports_info \
            "$(pst "SSH SETTINGS" "$(svc_state "$(ssh_unit)")")|>ssh_menu" \
            "$(pst "DROPBEAR" "$(svc_state vpspanel-dropbear)")|>dropbear_menu" \
            "$(pst "SOCKS/WS PROXY" "$( [[ -n $(wsp_ports) ]] && echo active)")|>wsp_menu" \
            "$(pst "STUNNEL (SSL)" "$(svc_state vpspanel-stunnel)")|>stunnel_menu" \
            "$(pst "SLOWDNS" "$(svc_state vpspanel-slowdns)")|>slowdns_menu" \
            "UDP-CUSTOM|soon" \
            "$(pst "UDP-HYSTERIA" "$(svc_state vpspanel-hysteria)")|>hysteria_menu" \
            "$(pst "BADVPN-UDPGW" "$( [[ -n $(bv_ports) ]] && echo active)")|>badvpn_menu" \
            "$(pst "SQUID" "$( [[ -s $SQUID_PORTS ]] && svc_state squid)")|>squid_menu" \
            "$(pst "OPENVPN" "$(svc_state vpspanel-openvpn)")|>openvpn_menu" \
            "$(pst "CHECKUSER ONLINE" "$(svc_state vpspanel-checkuser)")|>checkuser_menu" \
            "FILEBROWSER|soon" \
            "$(pst "V2RAY/XRAY" "$(svc_state vpspanel-xray)")|>xray_menu" \
            "$(pst "WIREGUARD" "$( wg_installed && svc_state wg-quick@wg0)")|>wireguard_menu"
        ret=$?
        MENU_COLS=1
        (( ret == 0 )) || return 0
    done
}

# ====================================================== extra tools ===
maint_info() {
    ui_kv "RAM:" "$(sys_ram)"
    ui_kv "Swap:" "$(sys_swap)"
    ui_kv "Disk:" "$(sys_disk)"
}
maintenance_menu() {
    while menu_show "SYSTEM MAINTENANCE" maint_info \
        "CLEAN RAM/CACHE|clean_ram" \
        "CLEAN DISK/CACHE (apt cache, old logs, old temp files)|clean_disk" \
        - \
        "CREATE SWAP FILE|swap_create" \
        "REMOVE SWAP FILE|swap_remove" \
        - \
        "SCHEDULED TASKS|soon"
    do :; done
}

cc_info() {
    ui_kv "Active:" "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo '?')"
    ui_kv "Available:" "$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null || echo '?')"
    ui_kv "Kernel:" "$(sys_kernel)"
}
cc_set() {
    local a
    ask a "Algorithm (bbr, cubic, reno...)" "bbr" || return
    if [[ $a == bbr ]]; then bbr_enable && ok "BBR enabled."; return; fi
    grep -qw -- "$a" <<< "$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null)" \
        || modprobe "tcp_$a" 2>/dev/null || { err "The kernel does not offer '$a'."; return 1; }
    bbr_disable > /dev/null 2>&1
    sysctl -qw "net.ipv4.tcp_congestion_control=$a" && ok "Congestion control: $a (until reboot; BBR is the persistent option)." \
        || err "Could not switch to '$a'."
}
bbr_menu() {
    while menu_show "KERNEL ACCELERATION (BBR)" cc_info \
        "ENABLE / DISABLE BBR $(st_onoff "$(bbr_enabled && echo 1 || echo 0)")|bbr_toggle" \
        "CHOOSE CONGESTION CONTROL ALGORITHM|cc_set"
    do :; done
}
bbr_toggle() { if bbr_enabled; then bbr_disable && ok "BBR disabled."; else bbr_enable && ok "BBR enabled."; fi; }

tz_menu_set() {
    local tz
    info "Examples: UTC, Europe/London, America/New_York, Africa/Addis_Ababa, Asia/Dubai"
    ask tz "Time zone" "$(tz_current)" && tz_set "$tz" && ok "Time zone set to $tz. Time now: $(date '+%F %H:%M')"
}
tz_info() { ui_kv "Time zone:" "$(tz_current)"; ui_kv "Local time:" "$(date '+%F %H:%M:%S')"; }
tz_menu() { while menu_show "TIME ZONE" tz_info "SET TIME ZONE|tz_menu_set" "USE UTC|tz_set UTC"; do :; done; }

extra_menu() {
    while menu_show "EXTRA TOOLS" - \
        "SSL CERTIFICATE MANAGER|>ssl_menu" \
        "SSH/DROPBEAR BANNER|>banner_menu" \
        "ROOT PASSWORD AND ACCESS|>root_menu" \
        - \
        "KERNEL ACCELERATION|>bbr_menu" \
        "SYSTEM MAINTENANCE (RAM/DISK)|>maintenance_menu" \
        - \
        "BLOCK TORRENT, PORTS AND KEYWORDS|>firewall_menu" \
        "FAIL2BAN MANAGER|>fail2ban_menu" \
        "DDOS PROTECTION|>ddos_menu" \
        - \
        "TIME ZONE|>tz_menu" \
        - \
        "SPEEDTEST|run_speedtest" \
        "PLUGIN SCRIPTS|soon"
    do :; done
}

